{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "outputDirectory": "public",
  "functions": {
    "api/server.ts": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/server"
    },
    {
      "source": "/conversation",
      "destination": "/api/server"
    },
    {
      "source": "/conversations",
      "destination": "/api/server"
    },
    {
      "source": "/message",
      "destination": "/api/server"
    },
    {
      "source": "/conversation/:id/messages",
      "destination": "/api/server"
    }
  ]
}
